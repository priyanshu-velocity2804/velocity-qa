{
  "display_information": {
    "name": "Product Importer",
    "description": "Tag me with Amazon/Flipkart links and I'll add them to Shopify."
  },
  "features": {
    "bot_user": { "display_name": "Product Importer", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:write",
        "files:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": { "is_enabled": false },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
