# --- Amazon (Rainforest API) ---
RAINFOREST_API_KEY=

# --- Flipkart (optional; only if Flipkart starts blocking requests) ---
# Raw Cookie header copied from a working browser request.
FLIPKART_COOKIE=

# --- Shopify ---
SHOPIFY_STORE=your-store.myshopify.com
# Either a Dev Dashboard app's client credentials (recommended for new apps)...
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or an existing admin-created custom app token (shpat_...).
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# DRAFT (review before selling) or ACTIVE
SHOPIFY_PRODUCT_STATUS=DRAFT
# Starting stock for newly created products (tracked by Shopify). Re-imports don't reset it.
INVENTORY_QUANTITY=100
# Location for that stock; leave empty to use the store's first active location
SHOPIFY_LOCATION_ID=
# Add a % on top of the scraped price and MRP, e.g. 10 for +10%
PRICE_MARKUP_PERCENT=0

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional: also trigger when someone tags this Slack user ID (e.g. you) with links
TRIGGER_USER_ID=
# Optional comma-separated allowlists
ALLOWED_CHANNEL_IDS=
ALLOWED_USER_IDS=
